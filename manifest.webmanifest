    },
    {
      "src": "assets/app-icon-light-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any",
      "media": "(prefers-color-scheme: light)"
    },
    {
      "src": "assets/app-icon-dark-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any",
      "media": "(prefers-color-scheme: dark)"
    },
    {
      "src": "assets/app-icon-dark-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any",
      "media": "(prefers-color-scheme: dark)"
    },
    {
      "src": "assets/app-icon-light.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
